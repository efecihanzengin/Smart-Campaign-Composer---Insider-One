# Copy to .env; docker compose reads it automatically.

# Claude API key. When set, the Segment and Content calls go to Claude; leave it
# empty to run on the scripted mock LLM (the UI then shows a "Mock LLM" badge).
# The key is never logged, and tests never need it.
ANTHROPIC_API_KEY=

# Claude model used when ANTHROPIC_API_KEY is set. Defaults to claude-sonnet-5-5;
# set it to override (e.g. claude-opus-5-5).
ANTHROPIC_MODEL=claude-sonnet-5-5

# Mock Provider behaviour. Each request for a message the Provider has not yet
# accepted is, at random: throttled (429 with Retry-After), failed (503), or
# accepted but answered only after PROVIDER_SLOW_MS, beyond the worker's
# timeout (the worker retries, and the Idempotency-Key makes the retry return
# the original acceptance instead of a duplicate). Rates are shares from 0 to 1
# and together may not exceed 1. Repeats of an accepted key always replay it.
PROVIDER_RATE_429=0.10
PROVIDER_RATE_5XX=0.05
PROVIDER_RATE_SLOW=0.03
# Retry-After sent with a 429, in seconds.
PROVIDER_RETRY_AFTER=1
# How long a slow response takes, in ms.
PROVIDER_SLOW_MS=10000
# Latency range of every other response, in ms.
PROVIDER_LATENCY_MIN_MS=20
PROVIDER_LATENCY_MAX_MS=300
# Seed for the random outcomes; empty means a new seed on every start.
PROVIDER_SEED=

# Worker retries. 429s (honouring Retry-After), 5xx and timeouts are retried
# with exponential backoff and jitter (base doubled per Attempt, capped at one
# minute) up to WORKER_MAX_ATTEMPTS Attempts, then the Delivery is failed; any
# other 4xx fails it at once. Empty means the default shown.
WORKER_BACKOFF_BASE_MS=500
WORKER_PROVIDER_TIMEOUT_MS=5000
WORKER_MAX_ATTEMPTS=5

# How long a claimed Delivery is held. A Delivery left `sending` past its lease
# (its worker crashed) is reclaimed by another worker; the Idempotency-Key makes
# the repeated request harmless. Values under twice the Provider timeout are
# raised to that. A stopped worker hands its Deliveries back at once.
WORKER_LEASE_MS=30000

# Most Provider requests per second on each Channel (SMS and email are limited
# independently). A burst of 429s halves it for a while; it then recovers.
RATE_LIMIT_PER_SECOND=100

# Host ports published by docker compose (all bound to 127.0.0.1).
WEB_PORT=5173
API_PORT=8080
POSTGRES_PORT=55432

# Set by docker compose for each container; only needed when running the Go
# binaries outside compose.
# DATABASE_URL=postgres://campaign:campaign@localhost:55432/campaign?sslmode=disable
# HTTP_ADDR=:8080
# PROVIDER_URL=http://localhost:8081
